/ Service card hover + stat counters (inline so they work without a Tailwind/webpacker rebuild)
css:
  /* Wrapper carries the AOS scroll-reveal so it never fights the card's own
     hover transform/transition (AOS sets its own duration/delay on its target). */
  .svc-grid-item { display: flex; }
  .svc-grid-item > .svc-card { flex: 1 1 auto; }

  /* Service card: smooth lift + subtle tilt toward the cursor + elevated shadow */
  .svc-card {
    position: relative;
    overflow: hidden;
    transform: perspective(1000px);
    transform-style: preserve-3d;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }
  .svc-card:hover {
    transform: perspective(1000px) translateY(-6px);
    box-shadow: 0 22px 48px -12px rgba(2, 6, 23, 0.30);
  }

  /* Cursor-tracking spotlight inside each card */
  .svc-spot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
    background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), rgba(37, 99, 235, 0.10), transparent 70%);
  }
  .svc-spot-light {
    background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.10), transparent 70%);
  }
  .svc-card:hover .svc-spot { opacity: 1; }

  /* Stat counter animation */
  .stat-counter {
    transition: none;
  }

  /* Apps grid: first app spans the full width, the rest sit two by two. */
  .apps-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .apps-grid-item { display: flex; }
  @media (min-width: 768px) {
    .apps-grid { grid-template-columns: 1fr 1fr; }
    .apps-grid-item:first-child { grid-column: span 2; }
    .apps-grid-item:first-child .app-card { flex-direction: row; }
    .apps-grid-item:first-child .app-shot { flex: 0 0 55%; aspect-ratio: auto; min-height: 20rem; }
    .apps-grid-item:first-child .app-body { justify-content: center; padding: 2.5rem; }
  }
  .app-card {
    display: flex; flex-direction: column; width: 100%; overflow: hidden;
    border-radius: 1rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
    color: inherit; text-decoration: none;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 220ms, background-color 220ms;
  }
  .app-card:hover { transform: translateY(-4px); border-color: rgba(96,165,250,0.5); background: rgba(255,255,255,0.07); }
  .app-shot { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #111827; }
  .app-shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .app-card:hover .app-shot img { transform: scale(1.03); }
  .app-body { display: flex; flex-direction: column; flex: 1; padding: 1.75rem; }
  .app-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .app-name { font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
  .app-platform { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #93c5fd; border: 1px solid rgba(147,197,253,0.35); border-radius: 9999px; padding: 0.125rem 0.625rem; }
  .app-tagline { color: #93c5fd; font-size: 1.125rem; margin-bottom: 0.75rem; }
  .app-desc { color: #d1d5db; line-height: 1.65; margin-bottom: 1.25rem; }
  .app-desc p + p { margin-top: 0.75rem; }
  .app-link { margin-top: auto; display: inline-flex; gap: 0.4rem; align-items: center; font-weight: 600; color: #fff; }
  .app-card:hover .app-link span { transform: translateX(3px); }
  .app-link span { transition: transform 200ms; }

  .copy-value { cursor: copy; text-align: left; border-bottom: 1px dashed transparent; transition: color 150ms, border-color 150ms; }
  .copy-value:hover { color: #2563eb; border-bottom-color: currentColor; }
  .copy-value.is-copied { color: #16a34a; border-bottom-color: transparent; }

  @media (prefers-reduced-motion: reduce) {
    .app-card, .app-shot img { transition: none; }
    .app-card:hover, .app-card:hover .app-shot img { transform: none; }
    .svc-card { transition: none; }
    .svc-card:hover { transform: none; }
    .svc-spot { display: none; }
  }

javascript:
  (function () {
    /* Company details: click copies the value without spaces or dots, so it pastes straight into a bank or tax form. */
    document.querySelectorAll('.copy-value').forEach(function (btn) {
      var original = btn.textContent;
      btn.addEventListener('click', function () {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(original.replace(/[\s.]/g, '')).then(function () {
          btn.textContent = btn.getAttribute('data-copied');
          btn.classList.add('is-copied');
          clearTimeout(btn._copyTimer);
          btn._copyTimer = setTimeout(function () {
            btn.textContent = original;
            btn.classList.remove('is-copied');
          }, 1200);
        });
      });
    });

    var mq = window.matchMedia;
    var reduce = mq && mq('(prefers-reduced-motion: reduce)').matches;
    var fine = mq && mq('(hover: hover) and (pointer: fine)').matches;

    /* Card spotlight: update --mx/--my per card (one delegated handler). Cheap enough to keep on touch too, but skip if reduced motion. */
    if (!reduce) {
      var cards = document.querySelectorAll('.svc-card');
      for (var i = 0; i < cards.length; i++) {
        (function (card) {
          var maxTilt = parseFloat(card.getAttribute('data-tilt')) || 6; // degrees, per-card override
          card.addEventListener('pointermove', function (e) {
            var r = card.getBoundingClientRect();
            var lx = e.clientX - r.left;
            var ly = e.clientY - r.top;
            card.style.setProperty('--mx', lx + 'px');
            card.style.setProperty('--my', ly + 'px');
            if (fine) {
              var px = lx / r.width - 0.5;   // -0.5 .. 0.5
              var py = ly / r.height - 0.5;
              var rotX = (-py * 2 * maxTilt).toFixed(2); // tilt toward cursor
              var rotY = (px * 2 * maxTilt).toFixed(2);
              card.style.transform = 'perspective(1000px) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg) translateY(-6px)';
            }
          });
          card.addEventListener('pointerleave', function () {
            card.style.transform = '';
          });
        })(cards[i]);
      }
    }

    /* Stat counter animation - trigger when stats section enters viewport */
    var statCounters = document.querySelectorAll('.stat-counter');
    if (statCounters.length && !reduce) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !entry.target.dataset.animated) {
            entry.target.dataset.animated = 'true';
            animateCounter(entry.target);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      statCounters.forEach(function (counter) {
        observer.observe(counter);
      });
    }

    function animateCounter(el) {
      var target = parseInt(el.getAttribute('data-count'), 10);
      var duration = 1800; // ms
      var start = 0;
      var startTime = null;

      function step(timestamp) {
        if (!startTime) startTime = timestamp;
        var progress = Math.min((timestamp - startTime) / duration, 1);
        // Ease out cubic
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = Math.floor(eased * target);
        el.textContent = current + (target >= 10 ? '+' : '');
        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = target + (target >= 10 ? '+' : '');
        }
      }
      requestAnimationFrame(step);
    }
  })();
